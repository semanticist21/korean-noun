{
  "name": "korean-noun",
  "version": "0.2.1",
  "description": "표준국어대사전 명사를 사용 빈도 순위로 랜덤 추출",
  "keywords": [
    "korean",
    "hangul",
    "noun",
    "random",
    "word",
    "dictionary",
    "한국어",
    "명사",
    "랜덤"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/korean-noun.git"
  },
  "license": "(MIT AND CC-BY-SA-4.0)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./top10": {
      "types": "./dist/top10.d.ts",
      "default": "./dist/top10.js"
    },
    "./top25": {
      "types": "./dist/top25.d.ts",
      "default": "./dist/top25.js"
    },
    "./top50": {
      "types": "./dist/top50.d.ts",
      "default": "./dist/top50.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "extract": "bun scripts/extract-stdict.ts",
    "count": "uv run scripts/count_wiki.py",
    "build:data": "bun scripts/build-data.ts",
    "test": "bun test",
    "e2e": "bun e2e/run.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "puppeteer-core": "25.11.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
